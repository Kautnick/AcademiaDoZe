<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="PageBackground">#17141F</Color>
      <Color x:Key="CardBackground">#231F2E</Color>
      <Color x:Key="CardElevated">#2D273A</Color>
      <Color x:Key="Accent">#A78BFA</Color>
      <Color x:Key="AccentStrong">#8B5CF6</Color>
      <Color x:Key="TextPrimary">#F5F1FC</Color>
      <Color x:Key="TextSecondary">#B8AFC9</Color>
      <Color x:Key="ErrorBackground">#3A2028</Color>
      <Color x:Key="ErrorBorder">#F87171</Color>
      <Color x:Key="CardStroke">#3A3348</Color>
      <Color x:Key="DangerBackground">#7F1D35</Color>
      <Color x:Key="DangerForeground">#FFFFFF</Color>
      <Color x:Key="ErrorForeground">#FECACA</Color>
      <Color x:Key="ShellForeground">#F5F1FC</Color>
      <Color x:Key="ShellUnselected">#B8AFC9</Color>
      <Color x:Key="ButtonForeground">#FFFFFF</Color>

      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
      </Style>

      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
      </Style>

      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardElevated}" />
        <Setter Property="HeightRequest" Value="48" />
      </Style>

      <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource Accent}" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentStrong}" />
        <Setter Property="TextColor" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
      </Style>

      <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardElevated}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
      </Style>

      <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource DangerForeground}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
